# =============================================================================
# FFSA Hub — local environment template
# =============================================================================
# Copy this file to `.env.local`, fill in the values, then `npm run dev`.
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored — never commit real secrets.
# Get the real values from an existing team member (via a password manager),
# or pull them from Vercel with:  vercel env pull .env.local
#
# [REQUIRED] = the app will not boot / core pages break without it.
# [OPTIONAL] = only needed for that specific feature; safe to leave blank in dev.
# =============================================================================


# --- Supabase (database + auth) -------------------------------------- [REQUIRED]
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Bypasses RLS — never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# --- App URLs -------------------------------------------------------- [REQUIRED]
# Used to build absolute links (emails, redirects, unsubscribe, share cards).
# In local dev both are usually http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- AI (campaign composer: Polish + Suggest Layout) ----------------- [OPTIONAL]
# https://console.anthropic.com/settings/keys
# Set in Vercel project env (all environments) so deployed previews/prod work.
ANTHROPIC_API_KEY=your-anthropic-api-key


# --- Email: Resend (ALL email — transactional + campaigns) ---------- [OPTIONAL]
# https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=hello@ffsahub.com
# Reply-To on reference invites and reminders, used only when the active
# "training" sending identity has no usable reply_to. A monitored inbox
# (the training Hub address, or a school mailbox someone reads). Never
# noreply@. Leave blank to send with no Reply-To rather than noreply@.
REFERENCE_REPLY_TO=
# Signing secret (whsec_...) of the webhook at resend.com → Webhooks pointed at
# /api/integrations/resend/webhook. Drives delivery/open/per-link click stats.
RESEND_WEBHOOK_SECRET=
# Who hears about a new staff member finishing onboarding — comma-separated.
# Also gates the matching "New staff member joined" item on the dashboard bell.
# Leave blank to switch the notice off entirely.
STAFF_SIGNUP_NOTIFY_EMAIL=
# Who hears about account deletion requests — comma-separated. Leave blank to
# email every active super admin / admin (the people who can delete users).
ACCOUNT_DELETION_NOTIFY_EMAIL=
# The address people are told to write to when the Hub can't take their
# deletion request itself. Blank = info@fireandfragrance.com.
ACCOUNT_DELETION_CONTACT_EMAIL=


# --- Secrets: cron + signed links ------------------------------------ [OPTIONAL]
# Any long random strings.
# CRON_SECRET must match the Authorization header Vercel Cron sends.
CRON_SECRET=your-long-random-secret
# HMAC secret for signed unsubscribe links in campaign emails.
UNSUBSCRIBE_TOKEN_SECRET=your-long-random-secret


# --- Payments: Stripe (card, international) --------------------------- [OPTIONAL]
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# "test" or "live"
STRIPE_MODE=test

# --- Payments: PayFast (card, ZAR) ----------------------------------- [OPTIONAL]
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
# "sandbox" or "live"
PAYFAST_MODE=sandbox


# --- Accounting: Xero (auto-posted invoices) ------------------------- [OPTIONAL]
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
# Where Xero returns the browser after consent. Must EXACTLY match a Redirect
# URI registered in the Xero developer portal. Defaults to localhost:3000, so
# production must set this or reconnecting Xero cannot work there.
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback
# Which Xero organisation each region bills into. Not secrets — just ids.
# Without these the callback has to guess, and with two organisations
# authorised it can bind both regions to the same one.
XERO_TENANT_ID_ZA=uuid-of-the-south-africa-organisation
XERO_TENANT_ID_US=uuid-of-the-us-organisation

# Missio income report (/missio/finance).
# 1 = the Xero connect flow also asks for read-only bank transactions and
# payments. Reconnect the SA organisation after switching it on.
XERO_REQUEST_BANK_READ_SCOPES=
# Optional: the Xero AccountID of Missio's bank account (SA organisation).
# Empty = the one active bank account whose name starts with "MISSIO".
MISSIO_XERO_BANK_ACCOUNT_ID=


# --- Google Calendar (dashboard "Upcoming Events" widget) ------------ [OPTIONAL]
# The calendar must be PUBLIC (Calendar settings → "Make available to public").
# API key: Google Cloud Console → APIs & Services → Credentials → API key,
# restricted to the Google Calendar API.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
# Full-calendar page opened when the widget is clicked (public embed view).
NEXT_PUBLIC_GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/embed?src=your-calendar-id&ctz=Africa%2FJohannesburg
# OAuth2 credentials for the staff auto-share feature (Settings → Google Calendar).
# Create a Web Application OAuth client in the same Google Cloud project.
# Add the redirect URI to the client's authorised redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://hub.ffsouthafrica.com/api/integrations/google-calendar/callback


# --- Slack integration ("FFSA Hub Activity" app) --------------------- [OPTIONAL]
# Bot OAuth token from https://api.slack.com/apps
# Scopes: chat:write, chat:write.public, im:write, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing Secret (Basic Information) — verifies inbound Slack requests.
SLACK_SIGNING_SECRET=
# Channel ids (look like C0123ABCD). Invite the bot to each channel.
SLACK_ACTIVITY_CHANNEL_ID=
# Daily ticket-sales report channel. Falls back to SLACK_ACTIVITY_CHANNEL_ID.
SLACK_TICKETS_REPORT_CHANNEL_ID=
# Prayer-room block-out / devo-set relocation notices.
SLACK_PRAYER_ROOM_CHANNEL_ID=
# Inbound Q&A bot: the private admin channel it answers in.
SLACK_ALLOWED_CHANNEL_ID=
# Comma-separated Slack user ids (U…,U…) allowed to query the bot.
SLACK_ALLOWED_USER_IDS=
# Open-ended read-only SQL tool — leave false unless explicitly enabled.
SLACK_ENABLE_SQL_TOOL=false

# --- "Hub" Slack app: private assistant for ministry leaders ---------- [OPTIONAL]
# A separate Slack app (docs/slack/hub-assistant-manifest.json). DM-only. OFF until
# HUB_SLACK_ASSISTANT_ENABLED is 1, and even then only on the live site
# (VERCEL_ENV=production). Never turn it on for Preview: previews share the prod DB.
# Uses ANTHROPIC_API_KEY. Setup steps: docs/slack/hub-assistant.md.
HUB_SLACK_ASSISTANT_ENABLED=
SLACK_ASSISTANT_BOT_TOKEN=
SLACK_ASSISTANT_SIGNING_SECRET=
# Optional private channel (C…) for a short note on each problem report. Invite the
# Hub app to it. Unset = reports are only saved in the Hub, nothing is posted.
SLACK_ASSISTANT_TICKET_CHANNEL_ID=

# In-app Hub assistant (chat bubble) — uses ANTHROPIC_API_KEY
AI_ASSISTANT_ENABLED=false            # true to show the bubble
AI_ASSISTANT_ROLES=                   # optional pilot, e.g. super_admin,admin (empty = everyone)
AI_ASSISTANT_DAILY_TOKENS=300000      # per person, rolling 24h
AI_ASSISTANT_MODEL_FAST=              # optional override, default claude-haiku-5-5
AI_ASSISTANT_MODEL_SMART=             # optional override, default claude-sonnet-5-5

# Phone app push notifications (Expo push service). Optional: only needed if
# "enhanced push security" is switched on for the Expo project. Server only.
EXPO_ACCESS_TOKEN=

# Missio volunteer links. Server only. The raw link is an HMAC of this secret,
# the request, the contact, and a stored nonce. Copying a link fails closed
# when this is empty, shorter than 32 characters, or still the placeholder.
# Use a long random string. Never commit a real value.
MISSIO_AVAILABILITY_TOKEN_SECRET=replace-with-a-long-random-string

# Fleet: messages (the 07:00 reminder email and its part of the Slack vehicle digest)
# are OFF until this is 1, and even then only on the live site (VERCEL_ENV=production).
# Leave it empty until the messages have been reviewed.
FLEET_MESSAGES_ENABLED=
# Vehicle bookings' pick-up and return messages to the person who booked and the drivers,
# and the coordinator's Returned / post-rental inspection messages (migration 364).
# Off unless 1 or true, and only in production.
VEHICLE_RENTAL_MESSAGES_ENABLED=

# Hub Forms: Slack DMs from form routes (e.g. a low leader score, a salvation) are OFF
# until this is 1, and even then only on the live site (VERCEL_ENV=production).
# Nothing sends yet; leave it empty.
HUB_FORMS_SLACK_ENABLED=

# Missio weekly feedback (Hub Forms F4): the 18:00 SAST Sunday Slack nudge to house
# leaders who have not sent. OFF until this is 1 AND HUB_FORMS_SLACK_ENABLED is 1, and
# only on the live site. Leave it empty until Jack OKs it.
HUB_FORMS_NUDGE_ENABLED=

# Missio weekly feedback: lets the ops script make the 20 house feedback links
# (supabase/scripts/ops/generate_missio_feedback_links.ts). Set it only in the shell that
# runs that script, after Jack OKs it. Never in Vercel.
MISSIO_FEEDBACK_LINKS_ENABLED=

# Missio WhatsApp inbox (/missio/whatsapp, migration 396). Pastors send from Missio's
# WhatsApp Business number inside the Hub. All five empty = switched off (503).
# Never commit real values; the token and secrets are never logged or sent to the browser.
#   ACCESS_TOKEN     permanent system-user token for the "Missio Hub" Meta app
#   PHONE_NUMBER_ID  the Cloud API phone number id (+27 82 360 7000)
#   WABA_ID          the WhatsApp Business Account id (templates are read from it)
#   APP_SECRET       the Meta app secret; checks X-Hub-Signature-256 on the webhook
#   VERIFY_TOKEN     any long random string; typed into Meta when subscribing the webhook
MISSIO_WHATSAPP_ACCESS_TOKEN=
MISSIO_WHATSAPP_PHONE_NUMBER_ID=
MISSIO_WHATSAPP_WABA_ID=
MISSIO_WHATSAPP_APP_SECRET=
MISSIO_WHATSAPP_VERIFY_TOKEN=


# --- Hub Store (/store, migration 412) -------------------------------- [OPTIONAL]
# PDF uploads (no env var needed): Vercel caps a function's REQUEST BODY at
# 4.5 MB, and a Review PDF is 20+ MB. So /store/admin never posts the PDF to a
# Hub route: it asks for a signed upload URL (JSON only), the browser PUTs the
# file straight into the private store-source bucket (50 MB max, enforced by
# the API and the bucket), then the Hub renders pages in the background.
# Don't change that to a route-handler upload. See src/lib/store/upload.ts.
# Checkout (PayFast sandbox, EFT, Stripe test mode) is closed unless this is 1. Previews share
# the production database: leave it off there unless you mean it.
STORE_PAYMENTS_ENABLED=0
# Store emails (order confirmations, gifts, fulfilment, Media notices, sign-in
# links) are only logged unless this is 1.
STORE_EMAILS_ENABLED=0
# Long random string (min 16 chars). Signs the short-lived page-image links.
STORE_SIGNING_SECRET=your-long-random-secret
# Where "new paid order" notices go — the Media team. Comma-separated.
STORE_MEDIA_NOTIFY_EMAIL=
# Card payments for the Store run in PayFast SANDBOX only (PAYFAST_MODE above).
# Leave this unset; it exists so going live is a deliberate, separate switch.
STORE_PAYFAST_ALLOW_LIVE=
# Bank details shown for EFT orders. EFT stays off until all four are set.
STORE_EFT_BANK=
STORE_EFT_ACCOUNT_NAME=
STORE_EFT_ACCOUNT_NUMBER=
STORE_EFT_BRANCH_CODE=
# International card payments for the Store (Stripe hosted Checkout, charged
# in ZAR). Off unless 1; also needs STRIPE_SECRET_KEY above and a webhook secret.
STORE_STRIPE_ENABLED=0
# The Store's Stripe webhook is its own Dashboard endpoint
# (<app>/api/store/stripe/webhook) with its OWN whsec_. Set it here; it falls
# back to STRIPE_WEBHOOK_SECRET (the events endpoint's) only if unset.
STORE_STRIPE_WEBHOOK_SECRET=
# Store Stripe refuses sk_live_ keys / STRIPE_MODE=live unless this is 1.
# Leave it unset; going live is a deliberate, separate switch.
STORE_STRIPE_ALLOW_LIVE=
