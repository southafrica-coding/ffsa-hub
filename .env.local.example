# =============================================================================
# FFSA Hub — local environment template
# =============================================================================
# Copy this file to `.env.local`, fill in the values, then `npm run dev`.
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored — never commit real secrets.
# Get the real values from an existing team member (via a password manager),
# or pull them from Vercel with:  vercel env pull .env.local
#
# [REQUIRED] = the app will not boot / core pages break without it.
# [OPTIONAL] = only needed for that specific feature; safe to leave blank in dev.
# =============================================================================


# --- Supabase (database + auth) -------------------------------------- [REQUIRED]
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only. Bypasses RLS — never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# --- App URLs -------------------------------------------------------- [REQUIRED]
# Used to build absolute links (emails, redirects, unsubscribe, share cards).
# In local dev both are usually http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- AI (campaign composer: Polish + Suggest Layout) ----------------- [OPTIONAL]
# https://console.anthropic.com/settings/keys
# Set in Vercel project env (all environments) so deployed previews/prod work.
ANTHROPIC_API_KEY=your-anthropic-api-key


# --- Email: Resend (ALL email — transactional + campaigns) ---------- [OPTIONAL]
# https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=hello@ffsahub.com
# Signing secret (whsec_...) of the webhook at resend.com → Webhooks pointed at
# /api/integrations/resend/webhook. Drives delivery/open/per-link click stats.
RESEND_WEBHOOK_SECRET=
# Who hears about a new staff member finishing onboarding — comma-separated.
# Also gates the matching "New staff member joined" item on the dashboard bell.
# Leave blank to switch the notice off entirely.
STAFF_SIGNUP_NOTIFY_EMAIL=
# Who hears about account deletion requests — comma-separated. Leave blank to
# email every active super admin / admin (the people who can delete users).
ACCOUNT_DELETION_NOTIFY_EMAIL=
# The address people are told to write to when the Hub can't take their
# deletion request itself. Blank = info@fireandfragrance.com.
ACCOUNT_DELETION_CONTACT_EMAIL=


# --- Secrets: cron + signed links ------------------------------------ [OPTIONAL]
# Any long random strings.
# CRON_SECRET must match the Authorization header Vercel Cron sends.
CRON_SECRET=your-long-random-secret
# HMAC secret for signed unsubscribe links in campaign emails.
UNSUBSCRIBE_TOKEN_SECRET=your-long-random-secret


# --- Payments: Stripe (card, international) --------------------------- [OPTIONAL]
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# "test" or "live"
STRIPE_MODE=test

# --- Payments: PayFast (card, ZAR) ----------------------------------- [OPTIONAL]
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
# "sandbox" or "live"
PAYFAST_MODE=sandbox


# --- Accounting: Xero (auto-posted invoices) ------------------------- [OPTIONAL]
XERO_CLIENT_ID=your-xero-client-id
XERO_CLIENT_SECRET=your-xero-client-secret
# Where Xero returns the browser after consent. Must EXACTLY match a Redirect
# URI registered in the Xero developer portal. Defaults to localhost:3000, so
# production must set this or reconnecting Xero cannot work there.
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback
# Which Xero organisation each region bills into. Not secrets — just ids.
# Without these the callback has to guess, and with two organisations
# authorised it can bind both regions to the same one.
XERO_TENANT_ID_ZA=uuid-of-the-south-africa-organisation
XERO_TENANT_ID_US=uuid-of-the-us-organisation


# --- Google Calendar (dashboard "Upcoming Events" widget) ------------ [OPTIONAL]
# The calendar must be PUBLIC (Calendar settings → "Make available to public").
# API key: Google Cloud Console → APIs & Services → Credentials → API key,
# restricted to the Google Calendar API.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
# Full-calendar page opened when the widget is clicked (public embed view).
NEXT_PUBLIC_GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/embed?src=your-calendar-id&ctz=Africa%2FJohannesburg
# OAuth2 credentials for the staff auto-share feature (Settings → Google Calendar).
# Create a Web Application OAuth client in the same Google Cloud project.
# Add the redirect URI to the client's authorised redirect URIs.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://hub.ffsouthafrica.com/api/integrations/google-calendar/callback


# --- Slack integration ("FFSA Hub Activity" app) --------------------- [OPTIONAL]
# Bot OAuth token from https://api.slack.com/apps
# Scopes: chat:write, chat:write.public, im:write, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Signing Secret (Basic Information) — verifies inbound Slack requests.
SLACK_SIGNING_SECRET=
# Channel ids (look like C0123ABCD). Invite the bot to each channel.
SLACK_ACTIVITY_CHANNEL_ID=
# Daily ticket-sales report channel. Falls back to SLACK_ACTIVITY_CHANNEL_ID.
SLACK_TICKETS_REPORT_CHANNEL_ID=
# Prayer-room block-out / devo-set relocation notices.
SLACK_PRAYER_ROOM_CHANNEL_ID=
# Inbound Q&A bot: the private admin channel it answers in.
SLACK_ALLOWED_CHANNEL_ID=
# Comma-separated Slack user ids (U…,U…) allowed to query the bot.
SLACK_ALLOWED_USER_IDS=
# Open-ended read-only SQL tool — leave false unless explicitly enabled.
SLACK_ENABLE_SQL_TOOL=false

# In-app Hub assistant (chat bubble) — uses ANTHROPIC_API_KEY
AI_ASSISTANT_ENABLED=false            # true to show the bubble
AI_ASSISTANT_ROLES=                   # optional pilot, e.g. super_admin,admin (empty = everyone)
AI_ASSISTANT_DAILY_TOKENS=300000      # per person, rolling 24h
AI_ASSISTANT_MODEL_FAST=              # optional override, default claude-haiku-5-5
AI_ASSISTANT_MODEL_SMART=             # optional override, default claude-sonnet-5-5
