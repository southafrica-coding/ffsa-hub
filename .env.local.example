# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CRM / Communications module
# Mailtrap "Email Sending" API token — marketing campaign sends
MAILTRAP_API_TOKEN=your-mailtrap-api-token
# HMAC secret for signed unsubscribe links (any long random string)
UNSUBSCRIBE_TOKEN_SECRET=your-long-random-secret
# Public base URL — used to build unsubscribe links in campaign emails
NEXT_PUBLIC_APP_URL=https://www.ffsahub.com
# Shared secret for the scheduled-send cron route (Vercel Cron Authorization)
CRON_SECRET=your-long-random-secret

# Anthropic API key — powers AI Polish + Suggest Layout in the campaign composer
# Get from https://console.anthropic.com/settings/keys
# Set in Vercel project env (all environments) so deployed previews/prod work
ANTHROPIC_API_KEY=your-anthropic-api-key

# Slack integration (Phase 1+)
# Bot OAuth token from https://api.slack.com/apps — your "FFSA Hub Activity" app
# Required scopes: chat:write, chat:write.public, im:write, users:read, users:read.email
# Set in Vercel project env (Production + Preview + Development)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# Optional fallback for #ffsa-activity channel id (used until the admin
# integration page writes slack_settings.channel_id). Slack channel ids look like C0123ABCD.
SLACK_ACTIVITY_CHANNEL_ID=
# Channel id for the daily ticket-sales report (cron: /api/cron/daily-ticket-report).
# Create a private channel (e.g. #ffsa-leadership) with just super admins, invite the
# bot, and put its id here. Falls back to SLACK_ACTIVITY_CHANNEL_ID when unset.
SLACK_TICKETS_REPORT_CHANNEL_ID=
# Dedicated prayer-room channel id (C…) for block-out / devo-set relocation
# notices. Invite the bot to the channel. When unset, block-outs still work —
# they just don't post to Slack.
SLACK_PRAYER_ROOM_CHANNEL_ID=

# Inbound Q&A bot (Slack v2) — "@FFSA Hub how many contacts under the Send label?"
# Signing Secret from the Slack App → Basic Information (verifies inbound requests)
SLACK_SIGNING_SECRET=
# The private admin channel id (C…) where the bot answers. DMs from allowed users also work.
SLACK_ALLOWED_CHANNEL_ID=
# Comma-separated Slack user ids (U…,U…) allowed to query the bot
SLACK_ALLOWED_USER_IDS=
# Open-ended read-only SQL tool (v2c) — leave false until that phase ships
SLACK_ENABLE_SQL_TOOL=false

# Google Calendar — dashboard "Upcoming Events" rotating widget
# The calendar must be PUBLIC (Calendar settings → "Make available to public").
# API key: Google Cloud Console → APIs & Services → Credentials → API key,
# restricted to the Google Calendar API. Set all three in Vercel project env too.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key
# Full-calendar page opened when the widget is clicked (public embed view).
NEXT_PUBLIC_GOOGLE_CALENDAR_URL=https://calendar.google.com/calendar/embed?src=your-calendar-id&ctz=Africa%2FJohannesburg

# Resend — transactional email (staff invites, password reset, and the
# per-event ticketing-analytics digests in the Reports tab).
# Set in Vercel project env for BOTH Production AND Preview (a Preview-scope
# gap breaks Preview builds/sends repo-wide).
RESEND_API_KEY=re_your-resend-api-key
# Optional "from" override; defaults to noreply@ffsahub.com when unset.
RESEND_FROM_EMAIL=noreply@ffsahub.com

# Twilio WhatsApp — powers the WhatsApp channel of the event ticketing
# digests (cron: /api/cron/event-reports). All optional: when unset the
# WhatsApp channel is skipped gracefully and email-only digests still send.
# Account SID (AC…) + Auth Token from the Twilio Console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# WhatsApp sender, including the "whatsapp:" prefix. Use the Twilio sandbox
# number for testing (e.g. whatsapp:+14155238886) or your approved sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved Content template SID (HX…) for the digest message. Required for
# business-initiated (outside-24h) sends in production. Leave unset to test
# free-form in the sandbox. Build/submit the template in Twilio Content
# Template Builder with 8 variables — see src/lib/reports/render-whatsapp.ts.
TWILIO_WA_REPORT_CONTENT_SID=
