# Copy this file to .env and fill it in. Never commit .env.

# Port the app runs on
PORT=8787

# Where the data, photos and PDFs are kept (created by "npm run seed")
DATA_DIR=data

# Optional: require a password. The browser asks for a name and this password.
# Leave empty on your own computer; set it on any server other people can reach.
APP_PASSWORD=

# Name shown for the signed-in user when there is no password
APP_USER_NAME=Vehicle co-ordinator

# Ask (chat with the app). Leave the key empty to switch Ask off.
# Get a key at https://console.anthropic.com. It stays on the server and is never sent to the browser.
ANTHROPIC_API_KEY=
# A current model id from https://docs.claude.com/en/docs/about-claude/models (a Sonnet model is a good default)
ANTHROPIC_MODEL=
# Optional: models for the app's "quick" and "complex" tiers (default: ANTHROPIC_MODEL)
ANTHROPIC_MODEL_QUICK=
ANTHROPIC_MODEL_COMPLEX=
# Optional: max Ask rounds per user per minute (one question can be a few rounds)
CLAUDE_MAX_PER_MIN=20

# Daily reminder (npm run reminder -- --post)
# An incoming-webhook URL from the Hub's Slack app
SLACK_WEBHOOK_URL=
# The link at the end of the reminder
APP_URL=http://localhost:8787
