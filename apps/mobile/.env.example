# FFSA Hub phone app: copy to .env (git-ignored) and fill in.
# Only PUBLIC values belong here: EXPO_PUBLIC_* is bundled into the app and
# readable by anyone who has it. Never put a service-role key or any other
# secret (Xero, Stripe, PayFast, Resend, Slack, Anthropic) in this file.

# Supabase project URL + anon (public) key: the same values as the website's
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Website the app calls for /api/* (needs the bearer-token support from web PR 1).
# Production: https://www.ffsahub.com  ·  testing: a Vercel preview URL of that PR.
EXPO_PUBLIC_API_BASE_URL=https://www.ffsahub.com

# Native app identifiers, read by app.config.ts at build time (not bundled).
# Leave unset until Jack picks them; the default is an obvious placeholder.
# APP_BUNDLE_ID=com.example.ffsahub
# APP_ANDROID_PACKAGE=com.example.ffsahub
