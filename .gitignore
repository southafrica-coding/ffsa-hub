# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code config
.claude/

# supabase local cli markers
supabase/.temp/

# mobile app (apps/mobile) — its own install and Expo/native build output.
# apps/mobile/.gitignore covers these too; repeated here so a root
# `git status` never shows them.
/apps/mobile/node_modules
/apps/mobile/.expo/
/apps/mobile/dist/
/apps/mobile/ios/
/apps/mobile/android/
